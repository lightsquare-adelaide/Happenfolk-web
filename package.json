{
  "name": "lightsquare-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude \"tests/access/**\" --exclude \"tests/auth/**\" --exclude \"tests/payments/**\" --exclude \"tests/media/**\" --exclude \"tests/events/**\" --exclude \"tests/portfolio/**\" --exclude \"tests/discovery/**\" --exclude \"tests/integration/**\" --exclude \"tests/compliance/**\"",
    "test:watch": "vitest",
    "check:invariants": "node scripts/check-invariants.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test:access": "vitest run tests/access",
    "test:access:redgreen": "node scripts/access-matrix.mjs",
    "test:auth": "vitest run tests/auth",
    "test:payments": "vitest run tests/payments",
    "test:media": "vitest run --no-file-parallelism tests/media",
    "test:events": "vitest run --no-file-parallelism tests/events",
    "test:portfolio": "vitest run --no-file-parallelism tests/portfolio",
    "test:discovery": "vitest run --no-file-parallelism tests/discovery",
    "test:compliance": "vitest run --no-file-parallelism tests/compliance",
    "seed:media": "node scripts/seed-media.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test:integration": "vitest run --no-file-parallelism tests/integration",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "kill:next": "node scripts/kill-next-servers.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "date-fns": "^4.4.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  }
}
