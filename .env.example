# EXAMPLE values only. Copy to .env.local (gitignored), then use your own local status.
# npx supabase status -o env: API_URL -> URL, ANON_KEY -> ANON_KEY,
# SERVICE_ROLE_KEY -> SERVICE_ROLE_KEY, DB_URL -> DB_URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=EXAMPLE_ONLY_LOCAL_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never expose through NEXT_PUBLIC_* or commit real credentials.
SUPABASE_SERVICE_ROLE_KEY=EXAMPLE_ONLY_LOCAL_SERVICE_ROLE_KEY
# Local SQL checks only; not required by web runtime.
SUPABASE_DB_URL=postgresql://postgres:EXAMPLE_PASSWORD@127.0.0.1:54322/postgres

# Optional: fixed test server port; stop manually started apps on it first.
# TEST_APP_PORT=3105
# Script target: BASE_URL=http://localhost:3000 npm run smoke
# CHROMIUM_PATH=/path/to/chromium

# Enable only behind a proxy that overwrites forwarded IP headers.
# VIEW_RECORDING_TRUST_FORWARDED_FOR=1

# Optional remote sample scripts NEVER fall back to local credentials.
# Both require --yes and an exact SEED_TARGET matching the URL host.
# SEED_SUPABASE_URL=https://example.supabase.co
# SEED_SERVICE_ROLE_KEY=EXAMPLE_ONLY_REMOTE_SERVICE_ROLE_KEY
# SEED_TARGET=example.supabase.co
# SEED_PASSWORD=EXAMPLE_ONLY_CHANGE_THIS_PASSWORD
